# ═══════════════════════════════════════════════
# Unison — Local Configuration
# Copy this file to .env and adjust as needed
# ═══════════════════════════════════════════════

# Ollama Settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding Model (FastEmbed)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# LanceDB Storage Path
LANCE_DB_PATH=.lancedb

# Deduplication Settings
DEDUP_SIMILARITY_THRESHOLD=0.85
DEDUP_TIME_WINDOW_MINUTES=30

# Batch Processing
BATCH_WINDOW_SECONDS=30

# Ingestion — IMAP Email (optional)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

# Ingestion — File Watch Directory (optional)
FILE_WATCH_DIR=./data/inbox

